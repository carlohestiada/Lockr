import { Head } from '@inertiajs/react';
import { useCallback, useEffect, useMemo, useState } from 'react';
import AppLayout from '@/layouts/app-layout';
import { type BreadcrumbItem } from '@/types';

type Folder = {
    id: number;
    name: string;
    credentials_count?: number;
};

type Credential = {
    id: number;
    title: string;
    username: string | null;
    website_url: string | null;
    folder_id: number | null;
    folder?: Folder | null;
    is_favorite: boolean;
    password?: string;
    notes?: string | null;
};

type CredentialForm = {
    title: string;
    username: string;
    password: string;
    website_url: string;
    notes: string;
    folder_id: string;
    is_favorite: boolean;
};

const breadcrumbs: BreadcrumbItem[] = [
    { title: 'Dashboard', href: '/dashboard' },
    { title: 'My Vault', href: '/vault' },
];

const emptyForm: CredentialForm = {
    title: '',
    username: '',
    password: '',
    website_url: '',
    notes: '',
    folder_id: '',
    is_favorite: false,
};

function csrfToken(): string {
    const cookie = document.cookie
        .split('; ')
        .find((item) => item.startsWith('XSRF-TOKEN='));

    return cookie ? decodeURIComponent(cookie.substring('XSRF-TOKEN='.length)) : '';
}

async function api<T>(url: string, options: RequestInit = {}): Promise<T> {
    const method = (options.method ?? 'GET').toUpperCase();
    const headers: Record<string, string> = {
        Accept: 'application/json',
        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
        ...(options.headers as Record<string, string> | undefined),
    };

    if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {
        const token = csrfToken();
        if (token) headers['X-XSRF-TOKEN'] = token;
    }

    const response = await fetch(url, {
        ...options,
        method,
        headers,
        credentials: 'same-origin',
    });

    if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        const errors = body.errors
            ? Object.values(body.errors).flat().join(' ')
            : body.message;

        throw new Error(errors || `Request failed (${response.status}).`);
    }

    if (response.status === 204) return undefined as T;
    return response.json() as Promise<T>;
}

export default function VaultIndex() {
    const [credentials, setCredentials] = useState<Credential[]>([]);
    const [folders, setFolders] = useState<Folder[]>([]);
    const [search, setSearch] = useState('');
    const [folderFilter, setFolderFilter] = useState('all');
    const [favoritesOnly, setFavoritesOnly] = useState(false);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState('');
    const [notice, setNotice] = useState('');
    const [formOpen, setFormOpen] = useState(false);
    const [editingId, setEditingId] = useState<number | null>(null);
    const [form, setForm] = useState<CredentialForm>(emptyForm);
    const [saving, setSaving] = useState(false);
    const [visiblePasswords, setVisiblePasswords] = useState<Record<number, string>>({});
    const [passwordLoadingId, setPasswordLoadingId] = useState<number | null>(null);

    const loadData = useCallback(async () => {
        setLoading(true);
        setError('');

        try {
            const [credentialResult, folderResult] = await Promise.all([
                api<{ data: Credential[] }>('/api/credentials'),
                api<Folder[]>('/api/folders'),
            ]);

            setCredentials(credentialResult.data);
            setFolders(folderResult);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to load your vault.');
        } finally {
            setLoading(false);
        }
    }, []);

    useEffect(() => {
        void loadData();
    }, [loadData]);

    const filteredCredentials = useMemo(() => {
        const term = search.trim().toLowerCase();

        return credentials.filter((credential) => {
            const matchesSearch =
                !term ||
                credential.title.toLowerCase().includes(term) ||
                (credential.username ?? '').toLowerCase().includes(term) ||
                (credential.website_url ?? '').toLowerCase().includes(term);

            const matchesFolder =
                folderFilter === 'all' ||
                (folderFilter === 'unfiled'
                    ? credential.folder_id === null
                    : credential.folder_id === Number(folderFilter));

            return (
                matchesSearch &&
                matchesFolder &&
                (!favoritesOnly || credential.is_favorite)
            );
        });
    }, [credentials, search, folderFilter, favoritesOnly]);

    function openCreateForm() {
        setEditingId(null);
        setForm(emptyForm);
        setError('');
        setNotice('');
        setFormOpen(true);
    }

    async function openEditForm(id: number) {
        setError('');
        setNotice('');

        try {
            const result = await api<{ data: Credential }>(`/api/credentials/${id}`);
            const credential = result.data;

            setEditingId(id);
            setForm({
                title: credential.title,
                username: credential.username ?? '',
                password: credential.password ?? '',
                website_url: credential.website_url ?? '',
                notes: credential.notes ?? '',
                folder_id: credential.folder_id === null ? '' : String(credential.folder_id),
                is_favorite: credential.is_favorite,
            });
            setFormOpen(true);
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to open credential.');
        }
    }

    async function togglePassword(id: number) {
        if (visiblePasswords[id] !== undefined) {
            setVisiblePasswords((current) => {
                const next = { ...current };
                delete next[id];
                return next;
            });
            return;
        }

        setPasswordLoadingId(id);

        try {
            const result = await api<{ data: Credential }>(`/api/credentials/${id}`);
            setVisiblePasswords((current) => ({
                ...current,
                [id]: result.data.password ?? '',
            }));
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to retrieve password.');
        } finally {
            setPasswordLoadingId(null);
        }
    }

    async function copyText(value: string, label: string) {
        try {
            await navigator.clipboard.writeText(value);
            setNotice(`${label} copied to clipboard.`);
            setError('');
        } catch {
            setError('Clipboard access failed. Check browser permissions.');
        }
    }

    async function saveCredential(event: React.FormEvent<HTMLFormElement>) {
        event.preventDefault();
        setSaving(true);
        setError('');
        setNotice('');

        const payload = {
            title: form.title.trim(),
            username: form.username || null,
            password: form.password,
            website_url: form.website_url || null,
            notes: form.notes || null,
            folder_id: form.folder_id ? Number(form.folder_id) : null,
            is_favorite: form.is_favorite,
        };

        try {
            if (editingId !== null) {
                await api(`/api/credentials/${editingId}`, {
                    method: 'PUT',
                    body: JSON.stringify(payload),
                });
                setNotice('Credential updated.');
            } else {
                await api('/api/credentials', {
                    method: 'POST',
                    body: JSON.stringify(payload),
                });
                setNotice('Credential added.');
            }

            setFormOpen(false);
            setForm(emptyForm);
            setVisiblePasswords({});
            await loadData();
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to save credential.');
        } finally {
            setSaving(false);
        }
    }

    async function createFolder() {
        const input = window.prompt('Enter a folder name:');

        if (input === null) {
            return;
        }

        const name = input.trim();

        if (!name) {
            setError('Folder name cannot be empty.');
            return;
        }

        setError('');
        setNotice('');

        try {
            await api('/api/folders', {
                method: 'POST',
                body: JSON.stringify({ name }),
            });

            await loadData();
            setNotice(`Folder "${name}" created successfully.`);
        } catch (err) {
            setError(
                err instanceof Error
                    ? err.message
                    : 'Unable to create folder.',
            );
        }
    }

    async function toggleFavorite(credential: Credential) {
        setError('');
        setNotice('');

        try {
            await api(`/api/credentials/${credential.id}`, {
                method: 'PUT',
                body: JSON.stringify({ is_favorite: !credential.is_favorite }),
            });
            await loadData();
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to update favorite.');
        }
    }

    async function deleteCredential(credential: Credential) {
        if (!window.confirm(`Delete "${credential.title}"? This cannot be undone.`)) {
            return;
        }

        setError('');
        setNotice('');

        try {
            await api(`/api/credentials/${credential.id}`, { method: 'DELETE' });
            setVisiblePasswords((current) => {
                const next = { ...current };
                delete next[credential.id];
                return next;
            });
            setNotice('Credential deleted.');
            await loadData();
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unable to delete credential.');
        }
    }

    return (
        <AppLayout breadcrumbs={breadcrumbs}>
            <Head title="My Vault" />

            <main className="flex flex-1 flex-col gap-6 p-4 md:p-6">
                <header className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h1 className="text-2xl font-semibold tracking-tight">My Vault</h1>
                        <p className="mt-1 text-sm text-muted-foreground">
                            Manage your saved accounts and credentials.
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={createFolder}
                        className="rounded-lg border px-4 py-2.5 text-sm font-medium"
                    >
                        + Create folder
                    </button>

                    <button
                        type="button"
                        onClick={openCreateForm}
                        className="rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90"
                    >
                        + Add credential
                    </button>
                </header>

                <section className="grid gap-3 sm:grid-cols-3">
                    <div className="rounded-xl border p-4">
                        <p className="text-sm text-muted-foreground">Credentials loaded</p>
                        <p className="mt-1 text-2xl font-semibold">{credentials.length}</p>
                    </div>
                    <div className="rounded-xl border p-4">
                        <p className="text-sm text-muted-foreground">Favorites</p>
                        <p className="mt-1 text-2xl font-semibold">
                            {credentials.filter((item) => item.is_favorite).length}
                        </p>
                    </div>
                    <div className="rounded-xl border p-4">
                        <p className="text-sm text-muted-foreground">Folders</p>
                        <p className="mt-1 text-2xl font-semibold">{folders.length}</p>
                    </div>
                </section>

                {error && (
                    <div role="alert" className="rounded-lg border border-destructive/40 bg-destructive/5 p-3 text-sm">
                        {error}
                    </div>
                )}

                {notice && (
                    <div role="status" className="rounded-lg border p-3 text-sm">
                        {notice}
                    </div>
                )}

                <section className="flex flex-col gap-3 sm:flex-row">
                    <input
                        aria-label="Search credentials"
                        value={search}
                        onChange={(event) => setSearch(event.target.value)}
                        placeholder="Search title, username, or website..."
                        className="min-w-0 flex-1 rounded-lg border bg-background px-3 py-2 text-sm"
                    />

                    <select
                        aria-label="Filter by folder"
                        value={folderFilter}
                        onChange={(event) => setFolderFilter(event.target.value)}
                        className="rounded-lg border bg-background px-3 py-2 text-sm"
                    >
                        <option value="all">All folders</option>
                        <option value="unfiled">Unfiled</option>
                        {folders.map((folder) => (
                            <option key={folder.id} value={folder.id}>
                                {folder.name}
                            </option>
                        ))}
                    </select>

                    <button
                        type="button"
                        aria-pressed={favoritesOnly}
                        onClick={() => setFavoritesOnly((value) => !value)}
                        className={`rounded-lg border px-3 py-2 text-sm ${favoritesOnly ? 'bg-accent font-medium' : ''}`}
                    >
                        {favoritesOnly ? '★ Favorites only' : '☆ Show favorites'}
                    </button>
                </section>

                <section className="overflow-hidden rounded-xl border">
                    {loading ? (
                        <p className="p-8 text-center text-sm text-muted-foreground">
                            Loading your vault…
                        </p>
                    ) : filteredCredentials.length === 0 ? (
                        <div className="p-10 text-center">
                            <h2 className="font-medium">
                                {credentials.length === 0 ? 'Your vault is empty' : 'No matching credentials'}
                            </h2>
                            <p className="mt-1 text-sm text-muted-foreground">
                                {credentials.length === 0
                                    ? 'Add your first credential to get started.'
                                    : 'Try a different search or filter.'}
                            </p>
                            {credentials.length === 0 && (
                                <button
                                    type="button"
                                    onClick={openCreateForm}
                                    className="mt-4 rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground"
                                >
                                    Add your first credential
                                </button>
                            )}
                        </div>
                    ) : (
                        <div className="divide-y">
                            {filteredCredentials.map((credential) => (
                                <article
                                    key={credential.id}
                                    className="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"
                                >
                                    <div className="min-w-0 flex-1">
                                        <div className="flex flex-wrap items-center gap-2">
                                            <h2 className="font-medium">{credential.title}</h2>
                                            {credential.is_favorite && (
                                                <span className="text-amber-500" aria-label="Favorite">★</span>
                                            )}
                                        </div>

                                        <p className="mt-1 break-all text-sm text-muted-foreground">
                                            {credential.username || 'No username saved'}
                                        </p>

                                        <p className="mt-1 text-xs text-muted-foreground">
                                            {credential.folder?.name ?? 'Unfiled'}
                                            {credential.website_url ? ` · ${credential.website_url}` : ''}
                                        </p>

                                        <div className="mt-3 flex flex-wrap items-center gap-2">
                                            <span className="rounded-md bg-muted px-2 py-1 font-mono text-sm">
                                                {visiblePasswords[credential.id] !== undefined
                                                    ? visiblePasswords[credential.id] || '(empty password)'
                                                    : '••••••••••'}
                                            </span>

                                            <button
                                                type="button"
                                                onClick={() => void togglePassword(credential.id)}
                                                disabled={passwordLoadingId === credential.id}
                                                className="text-xs underline disabled:opacity-50"
                                            >
                                                {passwordLoadingId === credential.id
                                                    ? 'Loading…'
                                                    : visiblePasswords[credential.id] !== undefined
                                                      ? 'Hide password'
                                                      : 'Show password'}
                                            </button>

                                            {visiblePasswords[credential.id] !== undefined && (
                                                <button
                                                    type="button"
                                                    onClick={() => void copyText(visiblePasswords[credential.id], 'Password')}
                                                    className="text-xs underline"
                                                >
                                                    Copy password
                                                </button>
                                            )}
                                            {credential.username && (
                                                <button
                                                    type="button"
                                                    onClick={() => void copyText(credential.username!, 'Username')}
                                                    className="text-xs underline"
                                                >
                                                    Copy username
                                                </button>
                                            )}
                                        </div>
                                    </div>

                                    <div className="flex flex-wrap gap-2">
                                        <button
                                            type="button"
                                            onClick={() => void toggleFavorite(credential)}
                                            aria-label={credential.is_favorite ? 'Remove favorite' : 'Add favorite'}
                                            className="rounded-md border px-3 py-2 text-sm"
                                        >
                                            {credential.is_favorite ? '★' : '☆'}
                                        </button>
                                        <button
                                            type="button"
                                            onClick={() => void openEditForm(credential.id)}
                                            className="rounded-md border px-3 py-2 text-sm"
                                        >
                                            Edit
                                        </button>
                                        <button
                                            type="button"
                                            onClick={() => void deleteCredential(credential)}
                                            className="rounded-md border border-destructive/40 px-3 py-2 text-sm text-destructive"
                                        >
                                            Delete
                                        </button>
                                    </div>
                                </article>
                            ))}
                        </div>
                    )}
                </section>

                {formOpen && (
                    <div
                        className="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/50 p-4"
                        role="presentation"
                        onMouseDown={(event) => {
                            if (event.target === event.currentTarget) setFormOpen(false);
                        }}
                    >
                        <section
                            role="dialog"
                            aria-modal="true"
                            aria-labelledby="credential-form-title"
                            className="my-auto max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-xl bg-background p-5 shadow-xl"
                        >
                            <h2 id="credential-form-title" className="text-lg font-semibold">
                                {editingId === null ? 'Add credential' : 'Edit credential'}
                            </h2>

                            <form onSubmit={saveCredential} className="mt-4 space-y-4">
                                <div>
                                    <label htmlFor="title" className="mb-1 block text-sm font-medium">Title *</label>
                                    <input
                                        id="title"
                                        required
                                        maxLength={150}
                                        value={form.title}
                                        onChange={(event) => setForm({ ...form, title: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    />
                                </div>

                                <div>
                                    <label htmlFor="username" className="mb-1 block text-sm font-medium">Username or email</label>
                                    <input
                                        id="username"
                                        maxLength={255}
                                        autoComplete="off"
                                        value={form.username}
                                        onChange={(event) => setForm({ ...form, username: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    />
                                </div>

                                <div>
                                    <label htmlFor="password" className="mb-1 block text-sm font-medium">Password *</label>
                                    <input
                                        id="password"
                                        required
                                        maxLength={10000}
                                        autoComplete="new-password"
                                        type="password"
                                        value={form.password}
                                        onChange={(event) => setForm({ ...form, password: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    />
                                </div>

                                <div>
                                    <label htmlFor="website_url" className="mb-1 block text-sm font-medium">Website URL</label>
                                    <input
                                        id="website_url"
                                        type="url"
                                        maxLength={2048}
                                        placeholder="https://example.com"
                                        value={form.website_url}
                                        onChange={(event) => setForm({ ...form, website_url: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    />
                                </div>

                                <div>
                                    <label htmlFor="folder_id" className="mb-1 block text-sm font-medium">Folder</label>
                                    <select
                                        id="folder_id"
                                        value={form.folder_id}
                                        onChange={(event) => setForm({ ...form, folder_id: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    >
                                        <option value="">Unfiled</option>
                                        {folders.map((folder) => (
                                            <option key={folder.id} value={folder.id}>{folder.name}</option>
                                        ))}
                                    </select>
                                </div>

                                <div>
                                    <label htmlFor="notes" className="mb-1 block text-sm font-medium">Notes</label>
                                    <textarea
                                        id="notes"
                                        rows={3}
                                        maxLength={10000}
                                        value={form.notes}
                                        onChange={(event) => setForm({ ...form, notes: event.target.value })}
                                        className="w-full rounded-lg border bg-background px-3 py-2 text-sm"
                                    />
                                </div>

                                <label className="flex items-center gap-2 text-sm">
                                    <input
                                        type="checkbox"
                                        checked={form.is_favorite}
                                        onChange={(event) => setForm({ ...form, is_favorite: event.target.checked })}
                                    />
                                    Mark as favorite
                                </label>

                                <div className="flex justify-end gap-2 border-t pt-4">
                                    <button
                                        type="button"
                                        onClick={() => setFormOpen(false)}
                                        className="rounded-lg border px-4 py-2 text-sm"
                                    >
                                        Cancel
                                    </button>
                                    <button
                                        type="submit"
                                        disabled={saving}
                                        className="rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground disabled:opacity-50"
                                    >
                                        {saving ? 'Saving…' : 'Save credential'}
                                    </button>
                                </div>
                            </form>
                        </section>
                    </div>
                )}
            </main>
        </AppLayout>
    );
}
